<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Inject FrontendConfig as CustomerSession's sessionConfig so initIniOptions() resets session.name
        back to 'PHPSESSID' — undoing 'admin' contamination left in the PHP process by a prior admin
        request on the same worker. (SessionStartPlugin handles the actual start + null-id repair.)
    -->
    <type name="Magento\Customer\Model\Session">
        <arguments>
            <argument name="sessionConfig" xsi:type="object">MageOS\WorkerMode\Session\FrontendConfig</argument>
        </arguments>
    </type>

    <!--
        Guard the Registration block against a missing last_order_id: in worker mode the session may not
        carry it when the success page renders, so OrderRepository::get(0) throws InputException. The plugin
        catches it and returns '' so the block hides silently.
    -->
    <type name="Magento\Checkout\Block\Registration">
        <plugin name="mage_os_worker_mode_checkout_registration_guard"
                type="MageOS\WorkerMode\Plugin\Checkout\Block\RegistrationPlugin"/>
    </type>

    <!--
        Last-resort recovery for DefaultConfigProvider::getConfig(): if it throws NoSuchEntityException
        because getCustomerId() was null, repair the CustomerSession via start(), clear the stale guest
        quote getQuote() cached, and retry once. CONTEXT_AUTH is never altered (that causes Hyvä reload loops).
    -->
    <type name="Magento\Checkout\Model\DefaultConfigProvider">
        <plugin name="mage_os_worker_mode_checkout_config_session_guard"
                type="MageOS\WorkerMode\Plugin\Checkout\Model\DefaultConfigProviderPlugin"/>
    </type>

    <!--
        LockWaitException guard on CheckoutSession::getQuote(): multiple workers may race to INSERT
        quote_address for the same customer; the loser gets MySQL 1205 with isLoading=true/_quote=null, so a
        plain retry throws LogicException. _resetState() clears those flags (quote_id preserved) and the
        retry succeeds. (The session start itself is handled by SessionStartPlugin.)
    -->
    <type name="Magento\Checkout\Model\Session">
        <plugin name="mage_os_worker_mode_checkout_session_lock_wait_guard"
                type="MageOS\WorkerMode\Plugin\Checkout\Model\CheckoutSessionPlugin"/>
    </type>

    <!--
        Safety net: preserve last_real_order_id across the depersonalize clearStorage() on the checkout
        success page (scoped to checkout_onepage_success only). Layout._resetState() fixes the root cause
        (stale _xml → page wrongly treated as cacheable → clearStorage before the order is read); this is
        belt-and-braces.
    -->
    <type name="Magento\Checkout\Model\Session">
        <plugin name="mage_os_worker_mode_checkout_preserve_order_data"
                type="MageOS\WorkerMode\Plugin\Checkout\Model\Session\PreserveOrderDataPlugin"/>
    </type>

    <!-- Pricing render keeps a nested layout across requests; sync its cacheable flag per request. -->
    <type name="Magento\Framework\Pricing\Render\Layout">
        <plugin name="mage_os_worker_mode_pricing_layout_cacheable"
                type="MageOS\WorkerMode\Plugin\Pricing\Render\LayoutCacheablePlugin"/>
    </type>
</config>
